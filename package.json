{
  "name": "olivos-store",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs && node tests/dom-audit.mjs && node tests/import-audit.mjs",
    "test:db": "node tests/database.test.mjs",
